{
  "id": "msteams-call",
  "name": "Teams Call by StandIn",
  "description": "Turn a Microsoft Teams call into a real two-way video conversation: the agent sees your camera and screen-share, talks in real time (speech-to-speech or streaming STT to agent to TTS), and appears as a lip-synced avatar. Vision, meeting recap, outbound call-backs, wake-phrase etiquette, HMAC-secured media bridge.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "post_chat_message",
      "call_me_with_the_answer"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "bindAddress": {
        "type": "string"
      },
      "path": {
        "type": "string",
        "description": "WebSocket path for the calling lane (default /msteams/calling)."
      },
      "secret": {
        "type": "string",
        "description": "The StandIn connection secret. ONE value covering BOTH lanes, calling and messages. Paste the value the StandIn portal shows you."
      },
      "requireRecordingStatus": {
        "type": "boolean"
      },
      "inboundPolicy": {
        "type": "string",
        "enum": [
          "disabled",
          "allowlist",
          "pairing",
          "open"
        ]
      },
      "allowFrom": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "inboundGreeting": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "realtime",
          "streaming"
        ]
      },
      "sessionScope": {
        "type": "string",
        "enum": [
          "per-phone",
          "per-call",
          "per-thread"
        ]
      },
      "maxConcurrentCalls": {
        "type": "integer",
        "minimum": 1
      },
      "maxDurationSeconds": {
        "type": "integer",
        "minimum": 1
      },
      "staleCallReaperSeconds": {
        "type": "integer",
        "minimum": 0
      },
      "outbound": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "workerBaseUrl": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "answerTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "defaultMode": {
            "type": "string",
            "enum": [
              "notify",
              "conversation"
            ]
          }
        }
      },
      "groupCall": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requireAddress": {
            "type": "boolean"
          },
          "wakePhrases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "followUpWindowMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxVisionPerMinute": {
        "type": "integer",
        "minimum": 0
      },
      "meetingRecap": {
        "type": "boolean"
      },
      "bilingual": {
        "type": "boolean"
      },
      "stt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "realtime": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "apiKey": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "azureEndpoint": {
                  "type": "string"
                },
                "azureDeployment": {
                  "type": "string"
                },
                "azureApiVersion": {
                  "type": "string"
                },
                "voice": {
                  "type": "string"
                },
                "silenceDurationMs": {
                  "type": "integer"
                },
                "prefixPaddingMs": {
                  "type": "integer"
                },
                "vadThreshold": {
                  "type": "number"
                },
                "interruptResponseOnInputAudio": {
                  "type": "boolean"
                },
                "minBargeInAudioEndMs": {
                  "type": "integer"
                }
              },
              "additionalProperties": true
            }
          },
          "instructions": {
            "type": "string"
          },
          "toolPolicy": {
            "type": "string",
            "enum": [
              "safe-read-only",
              "owner",
              "none"
            ]
          },
          "suppressInputDuringPlayback": {
            "type": "boolean"
          },
          "echoSuppressionWindowMs": {
            "type": "integer",
            "minimum": 0
          },
          "echoBargeInRms": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "managedBot": {
        "type": "object",
        "description": "COMPATIBILITY block for the messages lane. Prefer the flat keys beside the calling ones (messagesSecret / messagesPort / messagesPath) - they are the two lanes of one connection, not a sub-product. Still read so an existing config keeps working.",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Optional EXPLICIT override. The lane is enabled by the presence of a secret, so this is only needed as `false` to keep it off while a secret is configured."
          },
          "port": {
            "type": "number",
            "description": "HTTP port for the managed chat endpoint (default 9444)."
          },
          "bindAddress": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "POST path (default /msteams/messages)."
          },
          "chatSecret": {
            "type": [
              "string",
              "object"
            ],
            "description": "Per-lane secret for messages. Prefer the top-level `secret`, which covers both lanes."
          },
          "gatewayReplyUrl": {
            "type": "string",
            "description": "The StandIn gateway reply endpoint (default https://teams.standin.komaa.com/api/chat/reply)."
          }
        }
      },
      "messagesPort": {
        "type": "integer",
        "description": "HTTP port for the messages lane (default 9444).",
        "minimum": 1,
        "maximum": 65535
      },
      "messagesPath": {
        "type": "string",
        "description": "POST path for the messages lane (default /msteams/messages)."
      },
      "gatewayReplyUrl": {
        "type": "string",
        "description": "Where replies are posted. Defaults to the StandIn gateway; override only for a self-hosted StandIn. Flat here beside the other messages-lane keys - the docs have always shown it at the root, while the schema accepted it only under managedBot, and additionalProperties is false, so following the documentation produced a config that failed validation."
      },
      "callingPort": {
        "type": "integer",
        "description": "WebSocket port for the calling lane (default 9442). `port` is the older name and still works.",
        "minimum": 1,
        "maximum": 65535
      },
      "messagesBindAddress": {
        "type": "string",
        "description": "Bind address for the messages lane. Defaults to the root `bindAddress`, so both lanes share one interface; set this only to split them."
      }
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "secret",
          "expected": "string"
        },
        {
          "path": "managedBot.chatSecret",
          "expected": "string"
        },
        {
          "path": "realtime.providers.*.apiKey",
          "expected": "string"
        },
        {
          "path": "stt.providers.*.apiKey",
          "expected": "string"
        }
      ]
    }
  }
}
