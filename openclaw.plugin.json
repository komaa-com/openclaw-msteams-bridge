{
  "id": "msteams-voice",
  "name": "Teams Call by StandIn",
  "description": "Turn a Microsoft Teams call into a real two-way video conversation: the agent sees your camera and screen-share, talks in real time (speech-to-speech or streaming STT to agent to TTS), and appears as a lip-synced avatar. Vision, meeting recap, outbound call-backs, wake-phrase etiquette, HMAC-secured media bridge.",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "bindAddress": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "secret": {
        "type": "string",
        "description": "The single StandIn connection secret - covers calling AND chat. Paste the value from the StandIn portal; per-lane sharedSecret/messagesSecret override it when set."
      },
      "sharedSecret": {
        "type": [
          "string",
          "object"
        ]
      },
      "requireRecordingStatus": {
        "type": "boolean"
      },
      "inboundPolicy": {
        "type": "string",
        "enum": [
          "disabled",
          "allowlist",
          "pairing",
          "open"
        ]
      },
      "allowFrom": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "inboundGreeting": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "realtime",
          "streaming"
        ]
      },
      "sessionScope": {
        "type": "string",
        "enum": [
          "per-phone",
          "per-call",
          "per-thread"
        ]
      },
      "maxConcurrentCalls": {
        "type": "integer",
        "minimum": 1
      },
      "maxDurationSeconds": {
        "type": "integer",
        "minimum": 1
      },
      "staleCallReaperSeconds": {
        "type": "integer",
        "minimum": 0
      },
      "outbound": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "workerBaseUrl": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "answerTimeoutMs": {
            "type": "integer",
            "minimum": 1
          },
          "defaultMode": {
            "type": "string",
            "enum": [
              "notify",
              "conversation"
            ]
          }
        }
      },
      "groupCall": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "requireAddress": {
            "type": "boolean"
          },
          "wakePhrases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "followUpWindowMs": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "maxVisionPerMinute": {
        "type": "integer",
        "minimum": 0
      },
      "meetingRecap": {
        "type": "boolean"
      },
      "bilingual": {
        "type": "boolean"
      },
      "stt": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "realtime": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "provider": {
            "type": "string"
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "instructions": {
            "type": "string"
          },
          "toolPolicy": {
            "type": "string",
            "enum": [
              "safe-read-only",
              "owner",
              "none"
            ]
          },
          "suppressInputDuringPlayback": {
            "type": "boolean"
          },
          "echoSuppressionWindowMs": {
            "type": "integer",
            "minimum": 0
          },
          "echoBargeInRms": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "managedBot": {
        "type": "object",
        "description": "StandIn Managed Bot connection: StandIn provides the Teams bot, you connect this agent. Paste the chat secret from the StandIn portal; that alone turns the lane on. Leave unset for Bring-Your-Own-Azure-Bot deployments - voice is unaffected either way.",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean",
            "description": "Turn the managed chat endpoint on (also requires chatSecret)."
          },
          "port": {
            "type": "number",
            "description": "HTTP port for the managed chat endpoint (default 9444)."
          },
          "bindAddress": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "description": "POST path (default /managed/chat)."
          },
          "chatSecret": {
            "type": [
              "string",
              "object"
            ],
            "description": "The binding's CHAT HMAC key from the StandIn portal (separate from the voice sharedSecret)."
          },
          "gatewayReplyUrl": {
            "type": "string",
            "description": "The StandIn gateway reply endpoint (default https://teams.standin.komaa.com/api/chat/reply)."
          }
        }
      },
      "managedChat": {
        "type": "object",
        "description": "Deprecated alias for managedBot; still accepted. Prefer managedBot.",
        "additionalProperties": true
      }
    }
  },
  "configContracts": {
    "secretInputs": {
      "paths": [
        {
          "path": "secret",
          "expected": "string"
        },
        {
          "path": "sharedSecret",
          "expected": "string"
        },
        {
          "path": "managedChat.chatSecret",
          "expected": "string"
        },
        {
          "path": "managedBot.chatSecret",
          "expected": "string"
        },
        {
          "path": "realtime.providers.*.apiKey",
          "expected": "string"
        },
        {
          "path": "stt.providers.*.apiKey",
          "expected": "string"
        }
      ]
    }
  }
}
